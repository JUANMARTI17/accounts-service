# Servidor
PORT=8081
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL en Supabase (MISMA base que Users)
DB_HOST=<host_del_session_pooler_de_supabase>
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=<postgres.project_ref>
DB_PASSWORD=<password_de_supabase>
DB_SSL=true
DB_POOL_MAX=5

# Kafka en Aiven (MISMO broker que Users)
KAFKA_CLIENT_ID=accounts-service
KAFKA_BOOTSTRAP_SERVERS=<host:puerto_de_aiven>
KAFKA_USERNAME=<usuario_de_aiven>
KAFKA_PASSWORD=<password_de_aiven>
KAFKA_SSL_CA_LOCATION=./ca.pem
KAFKA_GROUP_ID=accounts-service
KAFKA_TOPIC_USER_CREATED=users.created
KAFKA_TOPIC_ACCOUNT_CREATED=accounts.created
